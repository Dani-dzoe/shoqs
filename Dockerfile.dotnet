# Multi-stage Dockerfile for C# ASP.NET Core 8 Web API
# St. Jude Hospital Queue Optimization Engine

# Step 1: SDK Build stage
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy project file and restore dependencies
COPY HospitalQueue.csproj ./
RUN dotnet restore HospitalQueue.csproj

# Copy remaining source code
COPY . ./

# Build and publish release binaries
RUN dotnet publish HospitalQueue.csproj -c Release -o /app/publish /p:UseAppHost=false

# Step 2: ASP.NET Core Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app

ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production

EXPOSE 5000

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "HospitalQueue.dll"]
